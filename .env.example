# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server HTTP & Socket.IO port (defaults to 3000)
PORT=3000

# CORS / Security: Comma-separated allowed origins for Socket.IO and Express APIs
ALLOWED_ORIGINS=""

# WebRTC STUN / TURN Infrastructure
# Public STUN servers are configured by default; configure TURN credentials for symmetric NAT traversal across networks.
STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
TURN_URLS=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# Firebase Cloud Messaging (FCM) Web Push VAPID Key (client-side public key)
VITE_FCM_VAPID_KEY=""

# Server-side Push Dispatch Credentials (optional; configure for background push notifications)
FCM_SERVICE_ACCOUNT_JSON=""
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID=""
APNS_PRIVATE_KEY=""
APNS_PRODUCTION="false"

# External PostgreSQL (for Railway / self-hosted PostgreSQL migration deployment; see migrations/001_initial_schema.sql)
DATABASE_URL=""
